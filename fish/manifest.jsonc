{
  "name": "fish",
  "description": "Like Bash, but with a better attitude, auto-suggestions, and colors.",
  "priority": 2,
  "builds": {
    "arch": ["sudo pacman -Syu --noconfirm fish fisher"],
    "cachyos": ["sudo pacman -S --noconfirm fish fisher"],
    "fedora": ["sudo dnf install fish fisher -y"],
    "nobara": ["sudo dnf install fish fisher -y"]
  },
  "configs": [
    {
      "from": "./src",
      "to": "~/.config/fish",
      "method": "symlink",
      "force": true,
      "tags": ["arch", "cachyos", "fedora", "nobara"]
    }
  ],
  "cleanup": ["rm -rf ~/.config/fish"]
}
